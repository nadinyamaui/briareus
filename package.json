{
  "name": "briareus",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The Briareus core: chat sessions with coding agents (claude / codex / grok / opencode), each in its own workspace clone with its own MySQL instance, served to clients over one API (/api/v1).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadinyamaui/briareus.git"
  },
  "homepage": "https://github.com/nadinyamaui/briareus#readme",
  "bugs": {
    "url": "https://github.com/nadinyamaui/briareus/issues"
  },
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-token": "node scripts/create-token.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:rollback": "node scripts/migrate.js rollback",
    "migrate:status": "node scripts/migrate.js status",
    "make:migration": "node scripts/migrate.js make",
    "build:api-docs": "node scripts/api-docs.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.285",
    "@openai/codex": "^0.159.2",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "opencode-ai": "^1.18.33",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
