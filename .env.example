# Everything below the "optional" line has a default and can be left out.
# Everything above it does not, and the server refuses to start without it.
# Each one names something about this machine (its database, its port, what it
# is called from outside, which model to run), and a default for one of those
# is a guess at somebody else's setup that fails quietly rather than loudly.
#
# Copy this file to .env and fill it in. `npm run create-token` writes
# AUTH_SECRET for you; nothing else here is written by a tool.

# ===========================================================================
# required
# ===========================================================================

# --- github ---
# Classic PAT with `repo`, or a fine-grained token with Pull requests:
# read/write and Contents: read. Used for the sessions' gh CLI and the
# branch-PR / CI sync shown in the session header.
# Adding Issues: read turns on the project view's ⊙ Issues tab. Without it
# everything else works as before and that one tab says what it is missing.
# A classic `repo` token already carries the permission.
# Adding Projects: read (a classic token's `read:project`) fills in the
# Projects v2 fields of GET /api/v1/issues/{number} and the project board
# (GET /api/v1/project-board). For a board owned by an organization, a
# fine-grained token needs Projects: read on that organization. Without it the
# issue is still read and the board says what it is missing. Projects:
# read/write (a classic token's `project`) also lets a client move a card to
# another column (POST /api/v1/project-board/move).
GITHUB_TOKEN=

# --- server ---
PORT=4300
# The public origin of this install, e.g. https://reviewer.example.com behind a
# Cloudflare tunnel. Two things read it: the video links a test run leaves on
# a pull request, and the GitHub webhook URL the app registers for itself. A
# localhost / .test hostname is a valid answer: it is treated as no public
# hostname at all, and everything stays polled.
PUBLIC_BASE_URL=http://localhost:4300
# Where the session clones are kept, and where a test run drops its scenario
# videos. Relative paths resolve against the app root, absolute paths are taken
# as they are. Keeping both out of this repo, next to it, is what stops a
# session from having the app's own tree inside its workspace.
WORKSPACE_DIR=../worktrees
TEST_VIDEOS_DIR=../test-videos

# --- claude ---
# The binary is auto-discovered (PATH, npm global, native installer). A hit on
# a mounted Windows drive (/mnt/...) is ignored: that is a host binary, not a
# Linux one. The model is not discovered: model names age out, and one baked
# into the code would keep being sent months after it was retired.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# --- database ---
# Session history (the jobs / job_events mirror), the projects, the providers
# and the prompt templates are stored here; the database and its tables are
# created on first run. Changes need a server restart. DB_PASSWORD may be
# empty, but the key has to be here: "no password" and "you forgot" are not
# the same answer.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reviewer
DB_USERNAME=root
DB_PASSWORD=

# --- the client API's signing secret ---
# Every /api/v1 token is signed with it. Written by the first
# `npm run create-token`, never by hand; until it is set the API answers
# nothing. Removing it and issuing a token again revokes every other one.
# AUTH_SECRET=

# ===========================================================================
# optional: behavior, with defaults that read the same on every install
# ===========================================================================

# Which interface the server listens on. Loopback only, because the way this
# install is meant to be reached from outside is a tunnel pointed at it, not an
# open port. A container is the one place to change it: there the port lives in
# a namespace of its own, and `docker compose` decides who may reach it.
# BIND_HOST=127.0.0.1

# --- the credentials key ---
# Encrypts the database login stored per SSH server and the API tokens of the
# Envoyer and Laravel Forge accounts. Optional: until it is set none of them can
# be saved, and everything else works. Any string of 32 or
# more characters; `openssl rand -base64 32` makes one. Changing it makes every
# stored login and token unreadable, so they have to be entered again.
# CREDENTIALS_KEY=

# --- the CLIs ---
# Auto-discovered like claude; override only if the discovery misses.
# CLAUDE_BIN=/home/you/.npm-global/bin/claude
# CODEX_BIN=/home/you/.npm-global/bin/codex
# GROK_BIN=/home/you/.grok/bin/grok
# OPENCODE_BIN=/home/you/.opencode/bin/opencode
# The Chromium a session's shared browser runs on. Found by itself when
# Playwright has downloaded one (any QA run does) or one is on PATH.
# BROWSER_BIN=/usr/bin/chromium
# Which binary each provider entry runs, its isolated login, its custom
# endpoint and its model list live in the database and are edited at /settings;
# only the four binaries above are hardcoded.

# --- per-session database pool ---
# Before a session starts, it claims one of the database servers configured at
# /settings, host, port and credentials per entry, so parallel sessions never
# share a database. The claimed server is injected as DB_HOST/DB_PORT/… into
# the session's environment, which beats the checkout's .env, and released when
# the session closes; extra sessions wait for a server to free up. Which
# projects claim one, and which database name a session uses on it, is set per
# project at /settings/projects.
# DB_POOL_ENABLED=true
# DB_POOL_WAIT_TIMEOUT_MIN=30
# DB_POOL_POLL_SECONDS=10

# --- developer sessions ---
# Only for the projects that claim a pooled database server, and only as the
# fallback for when the pool cannot answer (claiming off, or no servers
# configured yet), since otherwise the number of servers is the cap. A project with
# its database switched off holds nothing exclusive, so it may open as many
# sessions as it likes.
# DEV_MAX_SESSIONS=3
# Per turn, not per session, and only for a session that claimed one of the
# pooled database servers, since that claim is what its peers queue behind. A
# session without one (Local mode, or a project with the pool off) is in
# nobody's way and its turns run without a time limit.
# DEV_TIMEOUT_MIN=60
# The context size (tokens) at which a session with Auto-compact switched on
# (in its Context usage panel) has its Claude or Codex conversation summarized
# after the turn that crossed it. 0 disables auto-compaction everywhere.
# DEV_AUTO_COMPACT_TOKENS=250000

# --- the review loop (🔁) ---
# How many review rounds one armed loop runs before it stops and hands what is
# left back to you. The last round still reviews and still lists its findings on
# the pull request; it just does not start another fix turn. Without a cap a
# loop can keep reviewing the code its own fixes introduce: each round genuine,
# each round smaller, none of them the feature. 0 removes the cap and leaves
# only the stall gate (a round repeating the previous round's findings).
# REVIEW_LOOP_MAX_ROUNDS=10
# The last round on which a low finding is still implemented. From the round
# after it, lows are recorded on the pull request as optional instead of costing
# a fix turn and another review, since a low found late is nearly always a note on
# the previous round's fix rather than on the change under review. 0 never
# tightens, so every round implements everything it finds.
# REVIEW_LOOP_LOW_UNTIL_ROUND=1

# --- shared video links (Cloudflare R2) ---
# Off by default: the scenario videos then stay on this machine, served at
# /api/v1/videos to a client with a token, which means a video link on a pull
# request only opens for such a client, while the tunnel is up.
# Set all five keys and every test run composed from then on links its videos
# from the bucket instead: public, no login, alive when this machine is not.
# The videos still land in TEST_VIDEOS_DIR first; the server mirrors them to
# the bucket when the recording turn ends, so a link may trail the PR comment
# by a few seconds. Access control is the link itself (each run's path
# carries a random 128-bit token) so the bucket must not be listable, which
# an R2 public bucket already is not. Half the keys is refused at boot: a
# bucket the app can upload to but no public hostname (or the reverse) would
# be links pointing at videos that never arrive.
#
# The first four come from the R2 dashboard (an API token with Object Read &
# Write scoped to this one bucket, nothing wider); the fifth is the bucket's
# public side: its r2.dev URL, or the custom domain connected to it.
#
# These five, alone in this file, may be exported in the server's process
# environment instead of written here. The difference matters: this file is
# readable by every shell command a session runs, while the environment is
# stripped of R2_* before it reaches any job child. Prefer the environment
# for the secret; the Docker setup already does this on its own.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# --- ▶ Run through a Cloudflare tunnel (optional) ---
# When Briareus is used from another computer, the http://127.0.0.1
# URL a served app answers on is the viewer's own machine. With these set,
# ▶ Run publishes each app port through the tunnel Briareus already sits
# behind, the first time it is served: a Cloudflare Access application limited
# to PREVIEW_ACCESS_EMAILS, then the DNS record, then the tunnel's ingress
# route (in that order, so the hostname is never reachable unguarded). The
# routes are reused afterwards, one per port.
#
# All six or none. The token needs Account > Access: Apps and Policies > Edit,
# Account > Cloudflare Tunnel > Edit and Zone > DNS > Edit on this zone, and
# the tunnel must be dashboard-managed (its ingress lives in Cloudflare, not in
# a local config.yml). PREVIEW_HOSTNAME must carry {port} and sit one label
# under the zone so the universal certificate covers it. A run profile's
# tenants are published on the same port as <tenant>--<that label>
# (demo--preview-8101.example.com); put {tenant} in the first label to place
# the key yourself, e.g. {tenant}-preview-{port}.example.com.
#
# Like R2_*, these may be exported in the server's process environment instead
# of written here, and the token should be: this file is readable by every
# shell command a session runs, while the environment is stripped of
# CLOUDFLARE_* before it reaches any job child.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_TUNNEL_ID=
# PREVIEW_HOSTNAME=preview-{port}.example.com
# PREVIEW_ACCESS_EMAILS=you@example.com
#
# Optional, with the six above: a Cloudflare Access service token that lets a
# Briareus client (the Windows app's embedded browser) open previews without
# the emailed code. Create it once in Zero Trust > Access > Service
# credentials > Create service token (duration "Non-expiring", or rotate it
# here when it expires) and copy its Client ID and Client Secret: Cloudflare
# shows the secret only then. Both or neither. With them set, every preview
# Access application gets a second policy, "Briareus clients" (Service Auth,
# including this token); applications made before are given that one policy
# on their next ▶ Run and are otherwise left as they are. A manage token reads
# both through GET /api/v1/preview/access and sends them only to hosts under
# PREVIEW_HOSTNAME's domain. CLOUDFLARE_API_TOKEN then also needs
# Account > Access: Service Tokens > Read, to find the token's id.
#
# The tradeoff: any device holding a manage token can read the secret, and the
# secret opens every preview hostname, with no email check, until it is
# revoked in Cloudflare. Revoking a manage token does not take back a secret it
# already read; rotate the service token for that. Like CLOUDFLARE_*, export
# these in the server's environment rather than writing them here.
# PREVIEW_ACCESS_CLIENT_ID=
# PREVIEW_ACCESS_CLIENT_SECRET=

# --- voice notes (OpenAI transcription, optional) ---
# A client records a voice note (the composer's 🎤) and the server sends
# it to OpenAI's transcription API; the text lands in the message box to be
# corrected before it is sent. Without these the button is still shown, and
# says these two are missing when pressed. Both or neither: the model is named
# here rather than assumed, since model names age out (gpt-4o-transcribe,
# gpt-4o-mini-transcribe and whisper-1 all answer on the same route).
#
# Like R2_*, these may be exported in the server's process environment instead
# of written here, and the key should be: this file is readable by every shell
# command a session runs, while the environment is stripped of
# OPENAI_TRANSCRIBE_* before it reaches any job child.
# OPENAI_TRANSCRIBE_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# ===========================================================================
# not here at all
# ===========================================================================
#
# Projects (repositories, setup steps, PHP version, database, .env template,
# run commands), providers, the database pool and the prompt templates (the
# PR body this app writes and the errand behind every action) all live in the
# database and are edited at /settings.
