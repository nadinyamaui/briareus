# Load into the server's process environment before Node starts, not the app's .env.
# Change the proxy address for your installation.
NODE_USE_ENV_PROXY=1
HTTP_PROXY=http://127.0.0.1:3128
HTTPS_PROXY=http://127.0.0.1:3128
http_proxy=http://127.0.0.1:3128
https_proxy=http://127.0.0.1:3128
# Add internal service hostnames and LAN IPs to both lists.
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1
